{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Blaaiz": {
    "MinimalBusinessKybEnabled": false
  },
  "NotificationDelivery": {
    "WorkerEnabled": false,
    "PollIntervalSeconds": 15,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseMinutes": 2,
    "ProcessingTimeoutMinutes": 10,
    "Smtp": {
      "IsEnabled": false,
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "KorridorX"
    }
  },
  "Security": {
    "RateLimits": {
      "GlobalPermitLimit": 300,
      "GlobalWindowMinutes": 1,
      "AuthenticationPermitLimit": 10,
      "AuthenticationWindowMinutes": 1,
      "SensitivePermitLimit": 60,
      "SensitiveWindowMinutes": 1,
      "WebhookPermitLimit": 300,
      "WebhookWindowMinutes": 1
    },
    "Sessions": {
      "MaximumActiveSessionsPerUser": 10
    },
    "TransferRisk": {
      "IsEnabled": true,
      "ReviewScore": 40,
      "BlockScore": 70,
      "RecentRecipientHours": 24,
      "RapidTransferWindowMinutes": 60,
      "RapidTransferCount": 3,
      "DailyTransferCount": 5,
      "DuplicateTransferWindowHours": 24,
      "DuplicateTransferCount": 2,
      "FailedLoginWindowHours": 24,
      "FailedLoginCount": 3,
      "DistinctDeviceWindowDays": 30,
      "DistinctDeviceCount": 3,
      "HighValueThresholds": {
        "USD": 5000,
        "CAD": 5000,
        "GBP": 4000,
        "EUR": 4000,
        "NGN": 5000000
      }
    }
  },
  "Hosting": {
    "ApplicationName": "KorridorX",
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "RequireHttpsRedirection": true,
    "SwaggerEnabled": false,
    "JsonConsoleLogging": true,
    "SlowRequestThresholdMilliseconds": 1000,
    "CorrelationHeaderName": "X-Correlation-ID",
    "TrustedProxies": [],
    "ForwardLimit": 1,
    "DataProtectionKeysPath": ""
  },
  "ComplianceScreening": {
    "IsEnabled": false,
    "ProviderCode": "ConfiguredWatchlist",
    "RequireRecentClearScreeningForPayout": false,
    "FailClosedOnProviderError": true,
    "BlockDeclaredPep": true,
    "ScreeningValidityDays": 30,
    "PotentialMatchScore": 80,
    "BlockingMatchScore": 95,
    "RescreeningWorkerEnabled": false,
    "RescreeningIntervalHours": 24,
    "RescreeningBatchSize": 50,
    "TransactionMonitoring": {
      "IsEnabled": true,
      "ReviewScore": 40,
      "BlockScore": 70,
      "StructuringWindowHours": 24,
      "StructuringTransferCount": 3,
      "StructuringLowerPercentage": 0.75,
      "NewCorridorLookbackDays": 90,
      "MultipleBeneficiariesWindowHours": 24,
      "MultipleBeneficiariesCount": 4,
      "RollingAmountThresholds": {
        "USD": 10000,
        "CAD": 10000,
        "GBP": 8000,
        "EUR": 8000,
        "NGN": 10000000
      }
    },
    "Entries": []
  },
  "OpenSanctions": {
    "IsEnabled": false,
    "BaseUrl": "https://api.opensanctions.org",
    "ApiKey": "",
    "Dataset": "default",
    "MatchEndpoint": "match",
    "TimeoutSeconds": 30,
    "MaximumResults": 5,
    "RetryCount": 2,
    "RetryBaseDelayMilliseconds": 500,
    "BlockPepMatches": false,
    "IncludeDatasets": [],
    "ExcludeDatasets": []
  },
  "DataRetention": {
    "WorkerEnabled": false,
    "IntervalHours": 24,
    "BatchSize": 250
  },
  "Support": {
    "SlaWorkerEnabled": false,
    "SlaWorkerIntervalMinutes": 5,
    "InvestigationDueHours": 48,
    "SlaTargets": {
      "Low": {
        "FirstResponseMinutes": 480,
        "ResolutionMinutes": 4320
      },
      "Normal": {
        "FirstResponseMinutes": 240,
        "ResolutionMinutes": 2880
      },
      "High": {
        "FirstResponseMinutes": 60,
        "ResolutionMinutes": 1440
      },
      "Urgent": {
        "FirstResponseMinutes": 15,
        "ResolutionMinutes": 240
      }
    }
  }
}
