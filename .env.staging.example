ASPNETCORE_ENVIRONMENT=Staging

POSTGRES_DB=korridorx_staging
POSTGRES_USER=korridorx_staging
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
KORRIDORX_IMAGE_TAG=staging

JWT_ISSUER=https://api.staging.korridorx.com
JWT_AUDIENCE=KorridorX.Staging.Clients
JWT_KEY=replace-with-at-least-64-random-characters

ALLOWED_HOSTS=api.staging.korridorx.com
ALLOWED_ORIGIN=https://staging.korridorx.com

# Required account-security settings for the deployed Staging environment.
REQUIRE_CONFIRMED_EMAIL=true
ACCOUNT_FRONTEND_BASE_URL=https://staging.korridorx.com
MFA_ENFORCE_FOR_PRIVILEGED_ROLES=true
MFA_CODE_REPLAY_PEPPER=replace-with-at-least-32-random-characters

# Nginx terminates TLS. ASP.NET Core receives X-Forwarded-Proto from the local proxy.
REQUIRE_HTTPS_REDIRECTION=true
TRUSTED_PROXY_IP=172.30.0.1

BLAAIZ_ENABLED=false
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_WEBHOOK_SIGNING_SECRET=

COMPLIANCE_SCREENING_ENABLED=false
COMPLIANCE_SCREENING_REQUIRE_CLEAR_FOR_PAYOUT=false
COMPLIANCE_RESCREENING_WORKER_ENABLED=false

# Account-security email delivery is required in Staging.
# Use staging/sandbox SMTP credentials, never production credentials.
NOTIFICATION_WORKER_ENABLED=true
SMTP_ENABLED=true
SMTP_HOST=replace-with-staging-smtp-host
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=replace-with-staging-from-address
SMTP_FROM_NAME=KorridorX Staging

# Staging identity bootstrap
IDENTITY_SEED_TEST_USERS=false

IDENTITY_SUPERADMIN_FIRST_NAME=Staging
IDENTITY_SUPERADMIN_LAST_NAME=Administrator
IDENTITY_SUPERADMIN_EMAIL=replace-with-staging-admin-email
IDENTITY_SUPERADMIN_PASSWORD=replace-with-strong-staging-password
IDENTITY_SUPERADMIN_PHONE_NUMBER=
IDENTITY_SUPERADMIN_COUNTRY_CODE=CA
