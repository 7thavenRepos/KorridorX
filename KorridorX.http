@KorridorX_HostAddress = http://localhost:5112

### Start or retrieve current KYC application
POST {{KorridorX_HostAddress}}/api/kyc/applications/start
Authorization: Bearer {{accessToken}}
Accept: application/json

### Save KYC identity and create/refresh provider customer
PUT {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/identity
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "idType": "passport",
  "idNumber": "REPLACE_WITH_PROVIDER_TEST_ID",
  "idIssueDate": "2024-01-01",
  "idExpiryDate": "2030-01-01"
}

### Request identity-front upload URL
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/documents/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "documentType": 1,
  "fileName": "passport.jpg",
  "mimeType": "image/jpeg",
  "fileSizeBytes": 250000
}

### Upload the file directly to the returned uploadUrl
# Use the exact headers returned by the upload-url endpoint.
# PUT {{providerUploadUrl}}
# Content-Type: image/jpeg
#
# < ./passport.jpg

### Confirm provider upload
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/documents/{{kycDocumentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "providerFileId": "{{providerFileId}}"
}

### Submit KYC application for provider review
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/submit
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get current KYC status
GET {{KorridorX_HostAddress}}/api/kyc/status
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get provider customer mapping
GET {{KorridorX_HostAddress}}/api/customer-profile/me/provider
Authorization: Bearer {{accessToken}}
Accept: application/json

### Admin: list KYC applications
GET {{KorridorX_HostAddress}}/api/admin/kyc/applications?status=UnderReview&page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Admin: KYC application details
GET {{KorridorX_HostAddress}}/api/admin/kyc/applications/{{kycApplicationId}}
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Get available funding methods for a transfer
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collection-methods
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create a collection for a transfer
POST {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collections
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "paymentMethod": 4
}

### Get a transfer collection
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collection
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get my collections
GET {{KorridorX_HostAddress}}/api/collections?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Initiate an Interac collection (requires approved KYC)
POST {{KorridorX_HostAddress}}/api/collections/{{collectionId}}/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "payerEmail": "payer@example.com",
  "customerName": "Test Payer",
  "interacExpiryHours": 48
}

### Initiate a card collection (requires approved KYC)
POST {{KorridorX_HostAddress}}/api/collections/{{collectionId}}/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "redirectUrl": "https://example.com/payment/callback",
  "card": {
    "cardHolderName": "Test Customer",
    "cardNumber": "REPLACE_WITH_PROVIDER_TEST_CARD",
    "expiry": "12/30",
    "cvc": "123"
  }
}

### Blaaiz OAuth health check (Admin/SuperAdmin)
GET {{KorridorX_HostAddress}}/api/providers/blaaiz/health
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Get my payouts
GET {{KorridorX_HostAddress}}/api/payouts?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get payout for a transfer
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/payout
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get payout details
GET {{KorridorX_HostAddress}}/api/payouts/{{payoutId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Operations: manually dispatch a funded transfer payout
POST {{KorridorX_HostAddress}}/api/admin/transfers/{{transferId}}/payout/dispatch
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Operations: reconcile pending Blaaiz transactions
POST {{KorridorX_HostAddress}}/api/admin/providers/blaaiz/reconcile?batchSize=50
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Blaaiz collection webhook
# POST {{KorridorX_HostAddress}}/api/webhooks/blaaiz/collection
# x-blaaiz-signature: {{blaaizSignature}}
# x-blaaiz-timestamp: {{blaaizTimestamp}}
# Content-Type: application/json
#
# {{signedBlaaizCollectionPayload}}

### Blaaiz payout webhook
# POST {{KorridorX_HostAddress}}/api/webhooks/blaaiz/payout
# x-blaaiz-signature: {{blaaizSignature}}
# x-blaaiz-timestamp: {{blaaizTimestamp}}
# Content-Type: application/json
#
# {{signedBlaaizPayoutPayload}}

### Synchronize NGN banks (Admin/Operations)
POST {{KorridorX_HostAddress}}/api/admin/providers/blaaiz/banks/sync?countryCode=NG&currencyCode=NGN
Authorization: Bearer {{accessToken}}

### List synchronized banks
GET {{KorridorX_HostAddress}}/api/lookups/banks?countryCode=NG&page=1&pageSize=100
Authorization: Bearer {{accessToken}}

### Verify a recipient bank account
POST {{KorridorX_HostAddress}}/api/recipients/{{recipientId}}/bank-accounts/{{bankAccountId}}/verify
Authorization: Bearer {{accessToken}}

### Provider transaction monitoring
GET {{KorridorX_HostAddress}}/api/admin/providers/transactions?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Provider request monitoring
GET {{KorridorX_HostAddress}}/api/admin/providers/requests?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Webhook monitoring
GET {{KorridorX_HostAddress}}/api/admin/providers/webhooks?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Reconcile one provider transaction
POST {{KorridorX_HostAddress}}/api/admin/providers/transactions/{{providerTransactionRowId}}/reconcile
Authorization: Bearer {{accessToken}}

### Ask Blaaiz to replay one transaction webhook
POST {{KorridorX_HostAddress}}/api/admin/providers/transactions/{{providerTransactionRowId}}/webhook-replay
Authorization: Bearer {{accessToken}}

### Retry a failed payout
POST {{KorridorX_HostAddress}}/api/admin/payouts/{{payoutId}}/retry
Authorization: Bearer {{accessToken}}

### Initiate a supported collection refund
POST {{KorridorX_HostAddress}}/api/admin/collections/{{collectionId}}/refund
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "Recipient payout could not be completed."
}

### Refresh provider refund status
POST {{KorridorX_HostAddress}}/api/admin/collections/{{collectionId}}/refund/refresh
Authorization: Bearer {{accessToken}}

### Start FULL business KYB and create/update the provider business customer
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/start
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "businessName": "KorridorX Test Trading Inc.",
  "tradingName": "KorridorX Test",
  "businessType": "corporation",
  "registrationNumber": "TEST-RC-10001",
  "taxIdentificationNumber": "TEST-TIN-10001",
  "countryCode": "CA",
  "incorporationDate": "2022-01-15",
  "industryType": "financial_services",
  "businessDescription": "Sandbox remittance platform test business.",
  "website": "https://example.com",
  "sourceOfFunds": "business_revenue",
  "estimatedAnnualRevenue": "1000000-5000000",
  "expectedMonthlyPayments": 100,
  "accountPurpose": "supplier_and_customer_payments",
  "kybScope": 1,
  "stateOrProvince": "Ontario",
  "city": "Toronto",
  "addressLine1": "100 Test Street",
  "addressLine2": null,
  "postalCode": "M5V 1A1",
  "operatingCountryCode": "CA",
  "operatingStateOrProvince": "Ontario",
  "operatingCity": "Toronto",
  "operatingAddressLine1": "100 Test Street",
  "operatingAddressLine2": null,
  "operatingPostalCode": "M5V 1A1",
  "contactEmail": "business@example.com",
  "contactPhone": "+14165550100"
}

### Get current business KYB status
GET {{KorridorX_HostAddress}}/api/business-kyb/status
Authorization: Bearer {{accessToken}}
Accept: application/json

### Add a beneficial owner to a FULL KYB application
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/owners
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "email": "jane.owner@example.com",
  "dateOfBirth": "1988-04-15",
  "nationality": "CA",
  "countryCode": "CA",
  "title": "Director",
  "ownershipPercentage": 100,
  "hasControl": true,
  "isSigner": true,
  "isBeneficialOwner": true,
  "idDocumentType": "passport",
  "idDocumentNumber": "REPLACE_WITH_PROVIDER_TEST_ID",
  "idDocumentCountry": "CA",
  "idExpiryDate": "2030-04-15",
  "isPep": false
}

### Request an owner identity-front upload URL
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/owners/{{businessOwnerId}}/documents/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "side": 1,
  "fileName": "owner-passport.jpg",
  "mimeType": "image/jpeg"
}

### Upload the owner file directly to the returned uploadUrl
# Use every header returned by the upload-url endpoint.
# PUT {{providerUploadUrl}}
# Content-Type: image/jpeg
#
# < ./owner-passport.jpg

### Confirm and attach the uploaded owner file
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/owners/{{businessOwnerId}}/documents/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "side": 1,
  "providerFileId": "{{providerFileId}}"
}

### Request a business formation-document upload URL
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/documents/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "documentType": 1,
  "name": "Certificate of Incorporation",
  "fileName": "certificate-of-incorporation.pdf",
  "mimeType": "application/pdf",
  "description": "Current company formation document"
}

### Confirm and register the business formation document
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/documents/{{businessKybDocumentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "providerFileId": "{{providerFileId}}"
}

### Submit the business KYB application
POST {{KorridorX_HostAddress}}/api/business-kyb/applications/{{businessKybApplicationId}}/submit
Authorization: Bearer {{accessToken}}
Accept: application/json

### Admin: list business KYB applications
GET {{KorridorX_HostAddress}}/api/admin/business-kyb/applications?status=UnderReview&page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Admin: get business KYB application details
GET {{KorridorX_HostAddress}}/api/admin/business-kyb/applications/{{businessKybApplicationId}}
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Create a business beneficiary
POST {{KorridorX_HostAddress}}/api/business-beneficiaries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "beneficiaryType": 2,
  "name": "Example Supplier Limited",
  "contactFirstName": "Sam",
  "contactLastName": "Supplier",
  "nickname": "Primary supplier",
  "countryCode": "NG",
  "phoneNumber": "+2348000000000",
  "email": "payments@example-supplier.com",
  "relationshipOrPurpose": "Supplier payments"
}

### Add a bank account to a business beneficiary
POST {{KorridorX_HostAddress}}/api/business-beneficiaries/{{businessBeneficiaryId}}/bank-accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "countryCode": "NG",
  "currencyCode": "NGN",
  "bankName": "Provider bank name",
  "bankCode": "Provider bank code",
  "branchCode": null,
  "accountName": "Example Supplier Limited",
  "accountNumber": "0123456789",
  "iban": null,
  "swiftBic": null,
  "routingNumber": null,
  "sortCode": null,
  "providerBankId": "{{providerBankId}}",
  "isDefault": true
}

### Verify a business beneficiary bank account
POST {{KorridorX_HostAddress}}/api/business-beneficiaries/{{businessBeneficiaryId}}/bank-accounts/{{businessBeneficiaryBankAccountId}}/verify
Authorization: Bearer {{accessToken}}
Accept: application/json

### List business beneficiaries
GET {{KorridorX_HostAddress}}/api/business-beneficiaries?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json
