@KorridorX_HostAddress = http://localhost:5112

### Start or retrieve current KYC application
POST {{KorridorX_HostAddress}}/api/kyc/applications/start
Authorization: Bearer {{accessToken}}
Accept: application/json

### Save KYC identity and create/refresh provider customer
PUT {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/identity
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "idType": "passport",
  "idNumber": "REPLACE_WITH_PROVIDER_TEST_ID",
  "idIssueDate": "2024-01-01",
  "idExpiryDate": "2030-01-01"
}

### Request identity-front upload URL
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/documents/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "documentType": 1,
  "fileName": "passport.jpg",
  "mimeType": "image/jpeg",
  "fileSizeBytes": 250000
}

### Upload the file directly to the returned uploadUrl
# Use the exact headers returned by the upload-url endpoint.
# PUT {{providerUploadUrl}}
# Content-Type: image/jpeg
#
# < ./passport.jpg

### Confirm provider upload
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/documents/{{kycDocumentId}}/confirm
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "providerFileId": "{{providerFileId}}"
}

### Submit KYC application for provider review
POST {{KorridorX_HostAddress}}/api/kyc/applications/{{kycApplicationId}}/submit
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get current KYC status
GET {{KorridorX_HostAddress}}/api/kyc/status
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get provider customer mapping
GET {{KorridorX_HostAddress}}/api/customer-profile/me/provider
Authorization: Bearer {{accessToken}}
Accept: application/json

### Admin: list KYC applications
GET {{KorridorX_HostAddress}}/api/admin/kyc/applications?status=UnderReview&page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Admin: KYC application details
GET {{KorridorX_HostAddress}}/api/admin/kyc/applications/{{kycApplicationId}}
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Get available funding methods for a transfer
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collection-methods
Authorization: Bearer {{accessToken}}
Accept: application/json

### Create a collection for a transfer
POST {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collections
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "paymentMethod": 4
}

### Get a transfer collection
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/collection
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get my collections
GET {{KorridorX_HostAddress}}/api/collections?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Initiate an Interac collection (requires approved KYC)
POST {{KorridorX_HostAddress}}/api/collections/{{collectionId}}/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "payerEmail": "payer@example.com",
  "customerName": "Test Payer",
  "interacExpiryHours": 48
}

### Initiate a card collection (requires approved KYC)
POST {{KorridorX_HostAddress}}/api/collections/{{collectionId}}/initiate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "redirectUrl": "https://example.com/payment/callback",
  "card": {
    "cardHolderName": "Test Customer",
    "cardNumber": "REPLACE_WITH_PROVIDER_TEST_CARD",
    "expiry": "12/30",
    "cvc": "123"
  }
}

### Blaaiz OAuth health check (Admin/SuperAdmin)
GET {{KorridorX_HostAddress}}/api/providers/blaaiz/health
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Get my payouts
GET {{KorridorX_HostAddress}}/api/payouts?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get payout for a transfer
GET {{KorridorX_HostAddress}}/api/transfers/{{transferId}}/payout
Authorization: Bearer {{accessToken}}
Accept: application/json

### Get payout details
GET {{KorridorX_HostAddress}}/api/payouts/{{payoutId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Operations: manually dispatch a funded transfer payout
POST {{KorridorX_HostAddress}}/api/admin/transfers/{{transferId}}/payout/dispatch
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Operations: reconcile pending Blaaiz transactions
POST {{KorridorX_HostAddress}}/api/admin/providers/blaaiz/reconcile?batchSize=50
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### Blaaiz collection webhook
# POST {{KorridorX_HostAddress}}/api/webhooks/blaaiz/collection
# x-blaaiz-signature: {{blaaizSignature}}
# x-blaaiz-timestamp: {{blaaizTimestamp}}
# Content-Type: application/json
#
# {{signedBlaaizCollectionPayload}}

### Blaaiz payout webhook
# POST {{KorridorX_HostAddress}}/api/webhooks/blaaiz/payout
# x-blaaiz-signature: {{blaaizSignature}}
# x-blaaiz-timestamp: {{blaaizTimestamp}}
# Content-Type: application/json
#
# {{signedBlaaizPayoutPayload}}

