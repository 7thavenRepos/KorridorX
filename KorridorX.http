Content-Disposition: form-data; name="name"

August supplier payments
--KorridorXBoundary
Content-Disposition: form-data; name="sourceCountryCode"

CA
--KorridorXBoundary
Content-Disposition: form-data; name="sourceCurrencyCode"

CAD
--KorridorXBoundary
Content-Disposition: form-data; name="fundingSource"

1
--KorridorXBoundary
Content-Disposition: form-data; name="file"; filename="business-payment-batch-template.csv"
Content-Type: text/csv

< ./Docs/business-payment-batch-template.csv
--KorridorXBoundary--

