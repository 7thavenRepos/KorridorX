ASPNETCORE_ENVIRONMENT=Development
REQUIRE_HTTPS_REDIRECTION=false

POSTGRES_DB=korridorx
POSTGRES_USER=korridorx
POSTGRES_PASSWORD=replace-with-a-strong-password

API_PORT=8080
JWT_ISSUER=KorridorX
JWT_AUDIENCE=KorridorX.Clients
JWT_KEY=replace-with-at-least-32-random-characters
ALLOWED_HOSTS=api.example.com
ALLOWED_ORIGIN=https://app.example.com
TRUSTED_PROXY_IP=
REQUIRE_CONFIRMED_EMAIL=true
ACCOUNT_FRONTEND_BASE_URL=https://app.example.com
ACCOUNT_TOKEN_LIFESPAN_MINUTES=120
MFA_ENFORCE_FOR_PRIVILEGED_ROLES=true
MFA_CODE_REPLAY_PEPPER=replace-with-at-least-32-random-characters

# Identity bootstrap. Keep real values in the environment/deployment secret
# store. Production ignores every TestUsers value and can create only the
# configured Super Administrator when none exists yet.
IdentitySeed__SeedTestUsers=false
IdentitySeed__SuperAdmin__FirstName=
IdentitySeed__SuperAdmin__LastName=
IdentitySeed__SuperAdmin__Email=
IdentitySeed__SuperAdmin__Password=
IdentitySeed__SuperAdmin__PhoneNumber=
IdentitySeed__SuperAdmin__CountryCode=

# Non-production only. All fields below are required when SeedTestUsers=true,
# except phone numbers and the country codes for internal staff accounts.
IdentitySeed__TestUsers__Consumer__FirstName=
IdentitySeed__TestUsers__Consumer__LastName=
IdentitySeed__TestUsers__Consumer__Email=
IdentitySeed__TestUsers__Consumer__Password=
IdentitySeed__TestUsers__Consumer__PhoneNumber=
IdentitySeed__TestUsers__Consumer__CountryCode=
IdentitySeed__TestUsers__BusinessOwner__FirstName=
IdentitySeed__TestUsers__BusinessOwner__LastName=
IdentitySeed__TestUsers__BusinessOwner__Email=
IdentitySeed__TestUsers__BusinessOwner__Password=
IdentitySeed__TestUsers__BusinessOwner__PhoneNumber=
IdentitySeed__TestUsers__BusinessOwner__CountryCode=
IdentitySeed__TestUsers__BusinessAdministrator__FirstName=
IdentitySeed__TestUsers__BusinessAdministrator__LastName=
IdentitySeed__TestUsers__BusinessAdministrator__Email=
IdentitySeed__TestUsers__BusinessAdministrator__Password=
IdentitySeed__TestUsers__BusinessAdministrator__PhoneNumber=
IdentitySeed__TestUsers__BusinessAdministrator__CountryCode=
IdentitySeed__TestUsers__ComplianceOfficer__FirstName=
IdentitySeed__TestUsers__ComplianceOfficer__LastName=
IdentitySeed__TestUsers__ComplianceOfficer__Email=
IdentitySeed__TestUsers__ComplianceOfficer__Password=
IdentitySeed__TestUsers__SupportOfficer__FirstName=
IdentitySeed__TestUsers__SupportOfficer__LastName=
IdentitySeed__TestUsers__SupportOfficer__Email=
IdentitySeed__TestUsers__SupportOfficer__Password=
IdentitySeed__TestUsers__OperationsOfficer__FirstName=
IdentitySeed__TestUsers__OperationsOfficer__LastName=
IdentitySeed__TestUsers__OperationsOfficer__Email=
IdentitySeed__TestUsers__OperationsOfficer__Password=
IdentitySeed__TestUsers__Administrator__FirstName=
IdentitySeed__TestUsers__Administrator__LastName=
IdentitySeed__TestUsers__Administrator__Email=
IdentitySeed__TestUsers__Administrator__Password=
IdentitySeed__Business__Name=
IdentitySeed__Business__CountryCode=

BLAAIZ_ENABLED=false
BLAAIZ_CLIENT_ID=
BLAAIZ_CLIENT_SECRET=
BLAAIZ_WEBHOOK_SIGNING_SECRET=

NOTIFICATION_WORKER_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Compliance screening stays disabled until a production provider is configured.
COMPLIANCE_SCREENING_ENABLED=false
COMPLIANCE_SCREENING_REQUIRE_CLEAR_FOR_PAYOUT=false
COMPLIANCE_RESCREENING_WORKER_ENABLED=false

# OpenSanctions hosted screening API (optional)
COMPLIANCESCREENING__PROVIDERCODE=OpenSanctions
OPENSANCTIONS__ISENABLED=false
OPENSANCTIONS__APIKEY=
OPENSANCTIONS__BASEURL=https://api.opensanctions.org

# Data retention worker remains disabled until policies and legal review are complete.
DATARETENTION__WORKERENABLED=false
DATARETENTION__INTERVALHOURS=24
DATARETENTION__BATCHSIZE=250
